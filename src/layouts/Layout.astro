---
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  canonical?: string;
  ogImage?: string;
  schema?: object | object[];
  noindex?: boolean;
}

const {
  title,
  description,
  canonical,
  ogImage = '/images/og-image.jpg',
  schema,
  noindex = false,
} = Astro.props;

const siteUrl = 'https://escolaeducabem.com.br';
const canonicalUrl = canonical ? `${siteUrl}${canonical}` : `${siteUrl}${Astro.url.pathname}`;

const schemaArray = Array.isArray(schema) ? schema : schema ? [schema] : [];

const localBusinessSchema = {
  "@context": "https://schema.org",
  "@type": "ChildCare",
  "name": "Escola Educa Bem",
  "image": `${siteUrl}/images/logo.jpg`,
  "url": siteUrl,
  "telephone": "+55-11-99348-4371",
  "address": {
    "@type": "PostalAddress",
    "streetAddress": "R. Dr. Miranda de Azevedo, 920",
    "addressLocality": "Pompeia",
    "addressRegion": "SP",
    "postalCode": "05027-000",
    "addressCountry": "BR"
  },
  "geo": {
    "@type": "GeoCoordinates",
    "latitude": -23.5353,
    "longitude": -46.6877
  },
  "openingHoursSpecification": [
    {
      "@type": "OpeningHoursSpecification",
      "dayOfWeek": ["Monday","Tuesday","Wednesday","Thursday","Friday"],
      "opens": "07:00",
      "closes": "18:00"
    }
  ],
  "description": "Berçário e educação infantil em Pompeia, São Paulo. Metodologia Reggio Emilia, crianças de 4 meses a 5 anos.",
  "aggregateRating": {
    "@type": "AggregateRating",
    "ratingValue": "5.0",
    "reviewCount": "12"
  },
  "priceRange": "$$",
  "servesCuisine": null,
  "sameAs": [
    "https://www.instagram.com/educa_bem",
    "https://escolaeducabem.wixsite.com/my-site"
  ]
};

const allSchemas = [localBusinessSchema, ...schemaArray];
---

<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta http-equiv="X-UA-Compatible" content="IE=edge" />

    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    {!noindex && <meta name="robots" content="index, follow, max-snippet:-1, max-image-preview:large, max-video-preview:-1" />}

    <!-- Open Graph -->
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={`${siteUrl}${ogImage}`} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="pt_BR" />
    <meta property="og:site_name" content="Escola Educa Bem" />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={`${siteUrl}${ogImage}`} />

    <!-- Favicons -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/x-icon" href="/favicon.ico" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />

    <!-- Preload critical font -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="preload" as="style" href="https://fonts.googleapis.com/css2?family=Nunito:ital,wght@0,400;0,600;0,700;0,800;0,900;1,800&display=swap" />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Nunito:ital,wght@0,400;0,600;0,700;0,800;0,900;1,800&display=swap" />

    <!-- Schema.org JSON-LD -->
    {allSchemas.map((s) => (
      <script type="application/ld+json" set:html={JSON.stringify(s)} />
    ))}

    <!-- Google Analytics 4 placeholder -->
    <!-- TODO: substituir G-XXXXXXXXXX pelo ID real do GA4 -->
    <!--
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-XXXXXXXXXX"></script>
    <script>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
      gtag('config', 'G-XXXXXXXXXX');
    </script>
    -->
  </head>
  <body>
    <a href="#main-content" class="skip-to-content">Ir para o conteúdo principal</a>

    <slot />

    <!-- Mobile sticky CTA bar -->
    <div class="mobile-cta-bar" id="mobileCta" role="navigation" aria-label="Contato rápido">
      <a
        href="tel:+5511993484371"
        class="cta-phone"
        aria-label="Ligar para a Escola Educa Bem"
      >
        📞
      </a>
      <a
        href="https://wa.me/5511993484371?text=Ol%C3%A1!%20Vi%20o%20site%20da%20Educa%20Bem%20e%20quero%20saber%20mais%20sobre%20as%20matr%C3%ADculas%20para%20meu%20filho(a).%20Podem%20me%20ajudar%3F"
        class="cta-whatsapp-bar pulse-whatsapp"
        target="_blank"
        rel="noopener noreferrer"
        aria-label="Abrir WhatsApp da Escola Educa Bem"
        id="whatsappCta"
      >
        <svg width="22" height="22" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
          <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/>
        </svg>
        💬 WhatsApp — Quero conhecer!
      </a>
    </div>

    <script>
      // Mobile CTA bar visibility
      const mobileCta = document.getElementById('mobileCta');
      let scrollTimeout: ReturnType<typeof setTimeout>;

      function showCta() {
        if (mobileCta && window.scrollY > 300) {
          mobileCta.classList.add('visible');
        }
      }

      setTimeout(showCta, 3000);

      window.addEventListener('scroll', () => {
        clearTimeout(scrollTimeout);
        scrollTimeout = setTimeout(showCta, 100);
      }, { passive: true });

      // Haptic feedback on WhatsApp tap
      const whatsappCta = document.getElementById('whatsappCta');
      whatsappCta?.addEventListener('click', () => {
        if ('vibrate' in navigator) {
          navigator.vibrate(50);
        }
      });

      // Scroll animations with IntersectionObserver
      const animElements = document.querySelectorAll('.animate-on-scroll');
      const observer = new IntersectionObserver((entries) => {
        entries.forEach((entry, i) => {
          if (entry.isIntersecting) {
            const el = entry.target as HTMLElement;
            el.style.animationDelay = `${i * 0.1}s`;
            el.classList.add('animated');
            observer.unobserve(el);
          }
        });
      }, { threshold: 0.15 });

      animElements.forEach(el => observer.observe(el));

      // Counter animation
      function animateCounter(el: Element) {
        const target = parseInt(el.getAttribute('data-target') || '0');
        const duration = 1500;
        const start = performance.now();

        function update(now: number) {
          const elapsed = now - start;
          const progress = Math.min(elapsed / duration, 1);
          const eased = 1 - Math.pow(1 - progress, 3);
          el.textContent = Math.floor(eased * target).toString();
          if (progress < 1) requestAnimationFrame(update);
        }
        requestAnimationFrame(update);
      }

      const counterObserver = new IntersectionObserver((entries) => {
        entries.forEach(entry => {
          if (entry.isIntersecting) {
            animateCounter(entry.target);
            counterObserver.unobserve(entry.target);
          }
        });
      }, { threshold: 0.5 });

      document.querySelectorAll('[data-target]').forEach(el => counterObserver.observe(el));
    </script>
  </body>
</html>
