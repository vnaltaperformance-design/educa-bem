---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

const WA_LINK = "https://wa.me/5511993484371?text=Ol%C3%A1!%20Vi%20o%20site%20da%20Educa%20Bem%20e%20quero%20saber%20mais%20sobre%20a%20proposta%20pedag%C3%B3gica.%20Podem%20me%20ajudar%3F";
---

<Layout
  title="Proposta Pedagógica — Reggio Emilia, Vygotsky e Piaget | Educa Bem Pompeia"
  description="Conheça a proposta pedagógica da Educa Bem: metodologia Reggio Emilia, sócio-interacionismo de Vygotsky, Piaget e Freinet. A base mais robusta do berçário na Pompeia."
  canonical="/proposta-pedagogica"
>
  <Header />
  <main id="main-content">

    <!-- HERO -->
    <section style="background:var(--color-secondary-light);padding:5rem 1.5rem;" aria-labelledby="pp-heading">
      <div style="max-width:900px;margin:0 auto;text-align:center;">
        <span style="font-size:0.8rem;font-weight:800;text-transform:uppercase;letter-spacing:0.1em;color:var(--color-secondary);">Proposta Pedagógica</span>
        <h1 id="pp-heading" style="font-size:clamp(2rem,4vw,3rem);font-weight:900;color:var(--color-dark);margin:0.75rem 0 1.25rem;">
          A base pedagógica mais robusta da Pompeia
        </h1>
        <p style="font-size:1.1rem;color:var(--color-dark-muted);max-width:700px;margin:0 auto 2rem;line-height:1.8;">
          Nossa metodologia é fundamentada nos maiores pensadores da educação infantil — e aplicada na prática, todo dia, com cada criança.
        </p>
        <a href={WA_LINK} target="_blank" rel="noopener noreferrer" class="btn-primary">
          💬 Agendar visita para conhecer
        </a>
      </div>
    </section>

    <!-- REGGIO EMILIA -->
    <section class="section-padding" aria-labelledby="reggio-heading">
      <div style="max-width:1100px;margin:0 auto;">
        <div style="display:grid;grid-template-columns:1fr 1fr;gap:4rem;align-items:center;" class="two-col-grid">
          <div class="animate-on-scroll">
            <span style="background:var(--color-secondary);color:white;border-radius:20px;padding:4px 14px;font-size:0.8rem;font-weight:700;">Referência Internacional</span>
            <h2 id="reggio-heading" style="font-size:clamp(1.6rem,3vw,2rem);color:var(--color-dark);margin:1rem 0 1.25rem;">
              Abordagem Reggio Emilia
            </h2>
            <p style="color:var(--color-dark-muted);line-height:1.8;margin:0 0 1rem;">
              Desenvolvida no norte da Itália após a Segunda Guerra Mundial, a abordagem Reggio Emilia é reconhecida pelo <strong>Newsweek</strong> como a melhor abordagem para educação infantil no mundo.
            </p>
            <p style="color:var(--color-dark-muted);line-height:1.8;margin:0 0 1.5rem;">
              Sua premissa central: <strong style="color:var(--color-secondary);">a criança é uma pesquisadora nata</strong>. Ela conhece o mundo com curiosidade, criatividade e competência. Nosso papel é criar o ambiente e as condições para que essa investigação floresça.
            </p>
            <ul style="list-style:none;margin:0;padding:0;display:flex;flex-direction:column;gap:0.75rem;">
              {['A criança como protagonista do aprendizado', 'Ambiente como "terceiro professor"', 'Documentação pedagógica das descobertas', 'Projetos que partem da curiosidade infantil', 'Parceria ativa com as famílias'].map(item => (
                <li style="display:flex;gap:0.5rem;align-items:flex-start;">
                  <span style="color:var(--color-secondary);font-weight:900;" aria-hidden="true">→</span>
                  <span style="color:var(--color-dark-muted);">{item}</span>
                </li>
              ))}
            </ul>
          </div>
          <div class="animate-on-scroll" style="border-radius:24px;overflow:hidden;aspect-ratio:4/3;">
            <img src="https://images.unsplash.com/photo-1503454537195-1dcabb73ffb9?w=700&q=80" alt="Metodologia Reggio Emilia na prática na Escola Educa Bem" width="700" height="525" loading="lazy" style="width:100%;height:100%;object-fit:cover;" />
          </div>
        </div>
      </div>
    </section>

    <!-- AUTORES -->
    <section class="section-padding" style="background:var(--color-bg-warm);" aria-labelledby="autores-heading">
      <div style="max-width:1100px;margin:0 auto;">
        <div style="text-align:center;margin-bottom:3rem;" class="animate-on-scroll">
          <h2 id="autores-heading" style="font-size:clamp(1.6rem,3vw,2rem);color:var(--color-dark);margin:0 0 0.75rem;">
            Fundamentação teórica
          </h2>
          <p style="color:var(--color-dark-muted);">Nossa proposta pedagógica é embasada nos maiores pensadores da educação.</p>
        </div>

        <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(280px,1fr));gap:2rem;">
          {[
            {
              name: 'Lev Vygotsky',
              years: '1896 – 1934',
              icon: '🧠',
              color: 'var(--color-secondary)',
              bg: 'var(--color-secondary-light)',
              concept: 'Sócio-Interacionismo',
              desc: 'O aprendizado acontece na interação social. A Zona de Desenvolvimento Proximal mostra que a criança aprende mais e melhor com a mediação de um adulto ou colega mais experiente.',
            },
            {
              name: 'Jean Piaget',
              years: '1896 – 1980',
              icon: '🔬',
              color: 'var(--color-primary)',
              bg: 'var(--color-primary-light)',
              concept: 'Desenvolvimento por Estágios',
              desc: 'Cada criança passa por estágios de desenvolvimento cognitivo bem definidos. Respeitamos e estimulamos o estágio em que cada criança se encontra, sem pressa e com intencionalidade.',
            },
            {
              name: 'Célestin Freinet',
              years: '1896 – 1966',
              icon: '🌍',
              color: '#7C3AED',
              bg: '#F3F0FF',
              concept: 'Aprendizagem pela Prática',
              desc: 'Aprender fazendo, vivendo e experimentando. Freinet nos ensina que a escola deve estar conectada com a vida real — nossa horta, projetos e atividades manuais são fruto dessa visão.',
            },
          ].map((autor) => (
            <div class="card-hover animate-on-scroll" style={`background:${autor.bg};border-radius:24px;padding:2rem;`}>
              <div style={`font-size:2.5rem;margin-bottom:1rem;`} aria-hidden="true">{autor.icon}</div>
              <div style={`display:inline-block;background:${autor.color};color:white;border-radius:20px;padding:3px 12px;font-size:0.75rem;font-weight:700;margin-bottom:0.75rem;`}>{autor.concept}</div>
              <h3 style={`font-size:1.3rem;font-weight:900;color:${autor.color};margin:0 0 0.25rem;`}>{autor.name}</h3>
              <div style="font-size:0.8rem;color:var(--color-dark-muted);margin-bottom:1rem;">{autor.years}</div>
              <p style="color:var(--color-dark-muted);font-size:0.9rem;line-height:1.7;margin:0;">{autor.desc}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- METODOLOGIA DE PROJETOS -->
    <section class="section-padding" style="background:white;" aria-labelledby="projetos-heading">
      <div style="max-width:900px;margin:0 auto;">
        <div class="animate-on-scroll" style="text-align:center;margin-bottom:3rem;">
          <h2 id="projetos-heading" style="font-size:clamp(1.6rem,3vw,2rem);color:var(--color-dark);margin:0 0 0.75rem;">
            Metodologia de Projetos
          </h2>
          <p style="color:var(--color-dark-muted);max-width:650px;margin:0 auto;">
            O currículo da Educa Bem é organizado em torno de temas investigativos que partem da curiosidade infantil — não de um livro didático.
          </p>
        </div>

        <div style="background:var(--color-accent);border-radius:24px;padding:2.5rem;margin-bottom:2rem;" class="animate-on-scroll">
          <div style="font-size:1.5rem;margin-bottom:1rem;" aria-hidden="true">💭</div>
          <p style="font-size:1.2rem;font-weight:700;color:var(--color-dark);margin:0;line-height:1.6;font-style:italic;">
            "Afinal, a curiosidade faz parte da infância. Como crescem as plantas? O que tem dentro do nosso corpo? Quando aparece o arco-íris?"
          </p>
          <p style="margin:0.75rem 0 0;color:var(--color-dark-muted);font-size:0.9rem;">— Perguntas reais que viram projetos reais na Educa Bem</p>
        </div>

        <div style="display:grid;grid-template-columns:1fr 1fr;gap:1.5rem;" class="two-col-grid-sm">
          {[
            { step: '1', title: 'A pergunta surge', desc: 'Uma criança faz uma pergunta genuína durante as atividades ou brincadeiras.' },
            { step: '2', title: 'O grupo investiga', desc: 'Toda a turma se engaja na investigação — com experimentos, livros, visitas e materiais.' },
            { step: '3', title: 'Registro e documentação', desc: 'As descobertas são registradas em desenhos, vídeos, escritas e painéis.' },
            { step: '4', title: 'Apresentação e celebração', desc: 'O projeto é compartilhado com as famílias, gerando orgulho e senso de autoria.' },
          ].map((item) => (
            <div class="animate-on-scroll" style="background:var(--color-bg-warm);border-radius:16px;padding:1.5rem;display:flex;gap:1rem;align-items:flex-start;">
              <div style="flex-shrink:0;width:40px;height:40px;background:var(--color-secondary);color:white;border-radius:12px;display:flex;align-items:center;justify-content:center;font-weight:900;">{item.step}</div>
              <div>
                <div style="font-weight:800;color:var(--color-dark);margin-bottom:0.25rem;">{item.title}</div>
                <div style="font-size:0.875rem;color:var(--color-dark-muted);">{item.desc}</div>
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- CTA -->
    <section class="section-padding" style="background:var(--color-primary);text-align:center;">
      <div style="max-width:600px;margin:0 auto;" class="animate-on-scroll">
        <h2 style="color:white;font-size:clamp(1.5rem,3vw,2rem);margin:0 0 1rem;">
          Quer ver nossa proposta na prática?
        </h2>
        <p style="color:rgba(255,255,255,0.85);margin:0 0 2rem;">
          Agende uma visita e observe como as crianças aprendem na Educa Bem.
        </p>
        <a href={WA_LINK} target="_blank" rel="noopener noreferrer"
          style="background:white;color:var(--color-primary);border-radius:50px;padding:16px 36px;font-size:1.05rem;font-weight:900;text-decoration:none;display:inline-flex;align-items:center;gap:8px;">
          📅 Agendar visita gratuita
        </a>
      </div>
    </section>

  </main>
  <Footer />
</Layout>

<style>
  .two-col-grid, .two-col-grid-sm {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 4rem;
    align-items: center;
  }
  @media (max-width: 768px) {
    .two-col-grid, .two-col-grid-sm {
      grid-template-columns: 1fr !important;
      gap: 2rem !important;
    }
  }
</style>
