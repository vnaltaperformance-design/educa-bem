---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "A partir de qual idade a Educa Bem aceita crianças?",
      "acceptedAnswer": { "@type": "Answer", "text": "A Escola Educa Bem aceita crianças a partir de 4 meses de idade no berçário." }
    },
    {
      "@type": "Question",
      "name": "Qual a metodologia pedagógica da Educa Bem?",
      "acceptedAnswer": { "@type": "Answer", "text": "A Educa Bem usa a metodologia Reggio Emilia com base sócio-interacionista, inspirada em Vygotsky, Piaget e Freinet." }
    },
    {
      "@type": "Question",
      "name": "A Educa Bem tem nutricionista?",
      "acceptedAnswer": { "@type": "Answer", "text": "Sim. A escola conta com nutricionista presente e atuante todos os dias, com cardápios adaptados por faixa etária." }
    },
    {
      "@type": "Question",
      "name": "Onde fica a Escola Educa Bem?",
      "acceptedAnswer": { "@type": "Answer", "text": "A escola fica na R. Dr. Miranda de Azevedo, 920, Pompeia, São Paulo, SP." }
    },
    {
      "@type": "Question",
      "name": "As matrículas estão abertas?",
      "acceptedAnswer": { "@type": "Answer", "text": "Sim, a Educa Bem aceita matrículas o ano todo. Entre em contato pelo WhatsApp para verificar a disponibilidade de vagas." }
    }
  ]
};

const WA_LINK = "https://wa.me/5511993484371?text=Ol%C3%A1!%20Vi%20o%20site%20da%20Educa%20Bem%20e%20quero%20saber%20mais%20sobre%20as%20matr%C3%ADculas%20para%20meu%20filho(a).%20Podem%20me%20ajudar%3F";
const WA_VISITA = "https://wa.me/5511993484371?text=Ol%C3%A1!%20Gostaria%20de%20agendar%20uma%20visita%20%C3%A0%20Escola%20Educa%20Bem.%20Qual%20a%20disponibilidade%3F";
---

<Layout
  title="Berçário e Educação Infantil em Pompeia SP | Escola Educa Bem"
  description="A Educa Bem é o berçário e escola de educação infantil na Pompeia, SP, que usa a metodologia Reggio Emilia para crianças de 4 meses a 5 anos. Matrículas abertas. Agende sua visita!"
  canonical="/"
  schema={faqSchema}
>
  <Header />

  <main id="main-content">

    <!-- HERO -->
    <section class="hero-gradient" style="padding:4rem 1.5rem 5rem;" aria-labelledby="hero-heading">
      <div style="max-width:1200px;margin:0 auto;" class="hero-grid">
        <div>
          <div style="display:inline-flex;align-items:center;gap:0.5rem;background:rgba(244,123,32,0.12);border:1.5px solid rgba(244,123,32,0.3);border-radius:20px;padding:6px 16px;margin-bottom:1.5rem;">
            <span style="width:8px;height:8px;background:#E53E3E;border-radius:50%;display:inline-block;" aria-hidden="true"></span>
            <span style="font-size:0.85rem;font-weight:700;color:var(--color-primary);">Vagas limitadas para 2025</span>
          </div>

          <h1 id="hero-heading" style="font-size:clamp(2rem,4vw,3rem);font-weight:900;color:var(--color-dark);margin:0 0 1rem;line-height:1.15;">
            Berçário e Educação Infantil
            na <span style="color:var(--color-primary);">Pompeia</span> que desperta
            a curiosidade do seu filho
          </h1>

          <p style="font-size:1.05rem;color:var(--color-dark-muted);margin:0 0 2rem;display:flex;flex-wrap:wrap;gap:0.5rem;align-items:center;">
            <span style="background:var(--color-secondary-light);color:var(--color-secondary);border-radius:20px;padding:4px 12px;font-weight:700;font-size:0.9rem;">Metodologia Reggio Emilia</span>
            <span style="background:var(--color-primary-light);color:var(--color-primary);border-radius:20px;padding:4px 12px;font-weight:700;font-size:0.9rem;">4 meses a 5 anos</span>
            <span style="background:var(--color-accent);color:var(--color-dark);border-radius:20px;padding:4px 12px;font-weight:700;font-size:0.9rem;">Pompeia, SP</span>
          </p>

          <div style="display:flex;flex-wrap:wrap;gap:1rem;margin-bottom:2rem;">
            <a href={WA_LINK} target="_blank" rel="noopener noreferrer" class="btn-primary">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/></svg>
              Quero conhecer a escola
            </a>
            <a href={WA_VISITA} target="_blank" rel="noopener noreferrer" class="btn-secondary">
              📅 Agendar visita presencial
            </a>
          </div>

          <div style="display:inline-flex;align-items:center;gap:0.75rem;padding:1rem 1.25rem;background:white;border-radius:16px;box-shadow:0 4px 16px rgba(0,0,0,0.06);">
            <div class="stars" style="font-size:1rem;" aria-label="5 estrelas">★★★★★</div>
            <div>
              <div style="font-weight:800;font-size:0.9rem;">5.0 de avaliação</div>
              <div style="font-size:0.8rem;color:var(--color-dark-muted);">"Meus filhos amam ir pra escola"</div>
            </div>
          </div>
        </div>

        <div style="border-radius:24px;overflow:hidden;aspect-ratio:4/3;position:relative;">
          <!-- TODO: substituir por foto real da escola -->
          <img
            src="https://images.unsplash.com/photo-1587654780291-39c9404d746b?w=800&q=80"
            alt="Criança explorando e aprendendo na Escola Educa Bem — Pompeia, São Paulo"
            width="800"
            height="600"
            loading="eager"
            fetchpriority="high"
            style="width:100%;height:100%;object-fit:cover;"
          />
          <div style="position:absolute;bottom:1rem;left:1rem;background:white;border-radius:12px;padding:0.75rem 1rem;box-shadow:0 4px 16px rgba(0,0,0,0.12);">
            <div style="font-weight:800;font-size:0.9rem;color:var(--color-secondary);">🌱 Reggio Emilia</div>
            <div style="font-size:0.75rem;color:var(--color-dark-muted);">Fundada em 2022 • Pompeia/SP</div>
          </div>
        </div>
      </div>
    </section>

    <!-- DIFERENCIAIS -->
    <section class="section-padding" style="background:white;" aria-labelledby="diferenciais-heading">
      <div style="max-width:1200px;margin:0 auto;">
        <div style="text-align:center;margin-bottom:3rem;" class="animate-on-scroll">
          <h2 id="diferenciais-heading" style="font-size:clamp(1.75rem,3vw,2.25rem);color:var(--color-dark);margin:0 0 0.75rem;">
            Por que as famílias da Pompeia escolhem a Educa Bem?
          </h2>
          <p style="color:var(--color-dark-muted);font-size:1.05rem;max-width:600px;margin:0 auto;">
            Uma escola que vai além do básico — proposta pedagógica robusta e cuidados que fazem diferença real.
          </p>
        </div>

        <div class="mobile-cards-scroll" style="grid-template-columns:repeat(auto-fit,minmax(280px,1fr));">
          {[
            { icon: '🌱', title: 'Metodologia Reggio Emilia', desc: 'Reconhecida mundialmente como a melhor abordagem para educação infantil. A criança como pesquisadora nata.' },
            { icon: '🧠', title: 'Base em Vygotsky, Piaget e Freinet', desc: 'Aprendizagem mediada pela interação social, desenvolvimento por estágios e aprendizagem pela prática.' },
            { icon: '🥗', title: 'Nutricionista todos os dias', desc: 'Profissional presente e atuante, cardápios por faixa etária, atendimento a restrições alimentares.' },
            { icon: '🌳', title: 'Horta e natureza na escola', desc: 'Árvores frutíferas e horta própria dentro do espaço. A natureza como sala de aula viva.' },
            { icon: '🍼', title: 'Berçário com leite materno', desc: 'Armazenamento seguro de leite materno para os bebês do berçário, com orientação às mães.' },
            { icon: '📝', title: 'Matrículas abertas o ano todo', desc: 'Seu filho pode começar a qualquer época. Atendemos crianças de 4 meses a 5 anos.' },
          ].map((item) => (
            <div class="card-hover animate-on-scroll" style="background:var(--color-bg-warm);border-radius:20px;padding:2rem;border:1.5px solid rgba(0,0,0,0.05);">
              <div style="font-size:2.5rem;margin-bottom:1rem;" aria-hidden="true">{item.icon}</div>
              <h3 style="font-size:1.05rem;font-weight:800;color:var(--color-dark);margin:0 0 0.75rem;">{item.title}</h3>
              <p style="font-size:0.9rem;color:var(--color-dark-muted);margin:0;line-height:1.7;">{item.desc}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- METODOLOGIA -->
    <section class="section-padding" style="background:var(--color-secondary-light);" aria-labelledby="metodologia-heading">
      <div style="max-width:1200px;margin:0 auto;" class="two-col-grid">
        <div class="animate-on-scroll">
          <span style="font-size:0.8rem;font-weight:800;text-transform:uppercase;letter-spacing:0.1em;color:var(--color-secondary);">Proposta Pedagógica</span>
          <h2 id="metodologia-heading" style="font-size:clamp(1.75rem,3vw,2.25rem);color:var(--color-dark);margin:0.5rem 0 1.25rem;">
            Como a Educa Bem ensina de verdade
          </h2>
          <p style="color:var(--color-dark-muted);margin:0 0 1.5rem;line-height:1.8;">
            Nossa metodologia é baseada na <strong style="color:var(--color-secondary);">abordagem Reggio Emilia</strong>, reconhecida mundialmente como a melhor para a educação infantil. Aqui, a criança é protagonista — uma pesquisadora curiosa que aprende investigando o mundo.
          </p>

          <div style="display:flex;flex-direction:column;gap:1rem;margin-bottom:2rem;">
            {[
              { num: '01', title: 'Curiosidade como motor', desc: '"Por que o arco-íris aparece?" — Cada pergunta vira um projeto real de investigação.' },
              { num: '02', title: 'Brincadeira intencional', desc: 'O brincar é parte integral do currículo, favorecendo autoestima e desenvolvimento criativo.' },
              { num: '03', title: 'Respeito individual', desc: 'Cada criança é estimulada ao máximo do seu potencial, respeitando seu estágio único.' },
              { num: '04', title: 'Interação social', desc: 'Vygotsky nos ensina: a interação é a base do aprendizado.' },
            ].map((item) => (
              <div style="display:flex;gap:1rem;align-items:flex-start;">
                <div style="flex-shrink:0;width:40px;height:40px;background:var(--color-secondary);color:white;border-radius:12px;display:flex;align-items:center;justify-content:center;font-weight:900;font-size:0.8rem;">{item.num}</div>
                <div>
                  <div style="font-weight:800;color:var(--color-dark);margin-bottom:0.2rem;">{item.title}</div>
                  <div style="font-size:0.875rem;color:var(--color-dark-muted);">{item.desc}</div>
                </div>
              </div>
            ))}
          </div>
          <a href="/proposta-pedagogica" class="btn-secondary" style="border-color:var(--color-secondary);color:var(--color-secondary);">
            Conheça nossa proposta completa →
          </a>
        </div>

        <div class="animate-on-scroll" style="border-radius:24px;overflow:hidden;aspect-ratio:3/4;">
          <!-- TODO: substituir por foto real -->
          <img
            src="https://images.unsplash.com/photo-1503454537195-1dcabb73ffb9?w=700&q=80"
            alt="Criança em momento de descoberta e aprendizagem na Educa Bem"
            width="700"
            height="933"
            loading="lazy"
            style="width:100%;height:100%;object-fit:cover;"
          />
        </div>
      </div>
    </section>

    <!-- TURMAS -->
    <section class="section-padding" aria-labelledby="turmas-heading">
      <div style="max-width:1200px;margin:0 auto;">
        <div style="text-align:center;margin-bottom:3rem;" class="animate-on-scroll">
          <h2 id="turmas-heading" style="font-size:clamp(1.75rem,3vw,2.25rem);color:var(--color-dark);margin:0 0 0.75rem;">
            Turmas para cada fase
          </h2>
          <p style="color:var(--color-dark-muted);">Da chegada ao mundo até os primeiros anos da infância.</p>
        </div>

        <div class="snap-x-container">
          {[
            {
              emoji: '🍼', title: 'Berçário', age: '4 meses – 1 ano',
              color: 'var(--color-primary)', bg: 'var(--color-primary-light)',
              desc: 'Ambiente acolhedor com profissionais especializados. Rotinas respeitosas, armazenamento de leite materno e muito cuidado.',
              link: '/bercario',
            },
            {
              emoji: '🧸', title: 'Maternal', age: '1 – 3 anos',
              color: 'var(--color-secondary)', bg: 'var(--color-secondary-light)',
              desc: 'Fase de exploração intensa. Brincadeiras sensoriais, interação social e primeiras descobertas do mundo.',
              link: '/educacao-infantil',
            },
            {
              emoji: '🌟', title: 'Jardim', age: '3 – 5 anos',
              color: '#7C3AED', bg: '#F3F0FF',
              desc: 'Projetos de investigação, socialização, pré-letramento e base sólida para o Ensino Fundamental.',
              link: '/educacao-infantil',
            },
          ].map((turma) => (
            <div class="snap-x-item card-hover animate-on-scroll" style={`background:${turma.bg};border-radius:24px;padding:2.5rem 2rem;`}>
              <div style="font-size:3rem;margin-bottom:1rem;" aria-hidden="true">{turma.emoji}</div>
              <div style={`display:inline-block;background:${turma.color};color:white;border-radius:20px;padding:4px 14px;font-size:0.8rem;font-weight:700;margin-bottom:1rem;`}>{turma.age}</div>
              <h3 style={`font-size:1.5rem;font-weight:900;color:${turma.color};margin:0 0 0.75rem;`}>{turma.title}</h3>
              <p style="color:var(--color-dark-muted);font-size:0.9rem;margin:0 0 1.5rem;line-height:1.7;">{turma.desc}</p>
              <a href={turma.link} style={`color:${turma.color};font-weight:800;text-decoration:none;font-size:0.95rem;`}>Saiba mais →</a>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- ALIMENTAÇÃO -->
    <section class="section-padding" style="background:var(--color-primary-light);" aria-labelledby="alimentacao-heading">
      <div style="max-width:1200px;margin:0 auto;" class="two-col-grid two-col-reverse">
        <div class="animate-on-scroll" style="border-radius:24px;overflow:hidden;aspect-ratio:4/3;">
          <!-- TODO: substituir por foto real -->
          <img
            src="https://images.unsplash.com/photo-1490645935967-10de6ba17061?w=700&q=80"
            alt="Alimentação saudável e colorida preparada para as crianças da Educa Bem"
            width="700"
            height="525"
            loading="lazy"
            style="width:100%;height:100%;object-fit:cover;"
          />
        </div>

        <div class="animate-on-scroll">
          <span style="font-size:0.8rem;font-weight:800;text-transform:uppercase;letter-spacing:0.1em;color:var(--color-primary);">Alimentação</span>
          <h2 id="alimentacao-heading" style="font-size:clamp(1.75rem,3vw,2.25rem);color:var(--color-dark);margin:0.5rem 0 1.25rem;">
            Nutricionista no dia a dia da sua criança
          </h2>
          <p style="color:var(--color-dark-muted);margin:0 0 1.5rem;">
            Na Educa Bem, a alimentação é levada a sério. Nossa nutricionista está <strong>presente todos os dias</strong> — não terceirizada — garantindo o desenvolvimento saudável de cada criança.
          </p>

          <ul style="list-style:none;margin:0 0 2rem;padding:0;display:flex;flex-direction:column;gap:0.75rem;">
            {[
              'Cardápios adaptados por faixa etária',
              'Atendimento a alergias e intolerâncias alimentares',
              'Opções vegetarianas disponíveis',
              'Cozinheira especializada em alimentação infantil',
              'Normas rigorosas da Vigilância Sanitária',
              'Armazenamento de leite materno para o berçário',
            ].map(item => (
              <li style="display:flex;gap:0.75rem;align-items:flex-start;">
                <span style="color:var(--color-secondary);font-size:1.1rem;flex-shrink:0;" aria-hidden="true">✓</span>
                <span style="color:var(--color-dark-muted);font-size:0.95rem;">{item}</span>
              </li>
            ))}
          </ul>
          <a href="/alimentacao" class="btn-primary">🥦 Ver cardápio e cuidados</a>
        </div>
      </div>
    </section>

    <!-- DEPOIMENTOS -->
    <section class="section-padding" style="background:var(--color-bg-warm);" aria-labelledby="depoimentos-heading">
      <div style="max-width:1200px;margin:0 auto;">
        <div style="text-align:center;margin-bottom:3rem;" class="animate-on-scroll">
          <h2 id="depoimentos-heading" style="font-size:clamp(1.75rem,3vw,2.25rem);color:var(--color-dark);margin:0 0 1rem;">
            O que as famílias dizem
          </h2>
          <div style="display:flex;align-items:center;justify-content:center;gap:1rem;">
            <div class="stars" aria-label="5 estrelas">★★★★★</div>
            <span style="font-size:2rem;font-weight:900;color:var(--color-dark);">5.0</span>
            <span style="color:var(--color-dark-muted);">de avaliação</span>
          </div>
        </div>

        <div class="mobile-cards-scroll" style="grid-template-columns:repeat(auto-fit,minmax(290px,1fr));">
          {[
            { quote: 'Eu só tenho elogios para a escola. Meus filhos são super bem tratados, eles amam ir para a escola. A equipe é maravilhosa!', name: 'Ana C.', role: 'Mãe de alunos do Maternal e Jardim' },
            { quote: 'A metodologia da Educa Bem é incrível. Vejo minha filha crescer não só em conhecimento, mas em autonomia e confiança.', name: 'Ricardo M.', role: 'Pai de aluna do Jardim' },
            { quote: 'Fico tranquila sabendo que tem nutricionista presente todos os dias. A alimentação do meu bebê é levada muito a sério.', name: 'Fernanda L.', role: 'Mãe de bebê do Berçário' },
          ].map((dep) => (
            <figure class="card-hover animate-on-scroll" style="background:white;border-radius:20px;padding:2rem;margin:0;box-shadow:0 4px 20px rgba(0,0,0,0.06);">
              <div class="stars" style="margin-bottom:1rem;" aria-label="5 estrelas">★★★★★</div>
              <blockquote style="margin:0 0 1.5rem;font-size:1rem;color:var(--color-dark-muted);line-height:1.8;font-style:italic;">"{dep.quote}"</blockquote>
              <figcaption style="display:flex;align-items:center;gap:0.75rem;">
                <div style="width:44px;height:44px;background:var(--color-primary-light);border-radius:50%;display:flex;align-items:center;justify-content:center;font-size:1.2rem;" aria-hidden="true">👨‍👩‍👧</div>
                <div>
                  <div style="font-weight:800;color:var(--color-dark);font-size:0.95rem;">{dep.name}</div>
                  <div style="font-size:0.8rem;color:var(--color-dark-muted);">{dep.role}</div>
                </div>
              </figcaption>
            </figure>
          ))}
        </div>

        <div class="mobile-col" style="display:grid;grid-template-columns:repeat(3,1fr);gap:2rem;margin-top:4rem;text-align:center;">
          {[
            { target: '120', suffix: '+', label: 'Famílias atendidas', icon: '👨‍👩‍👧‍👦' },
            { target: '4', suffix: ' anos', label: 'De história na Pompeia', icon: '🏫' },
            { target: '5', suffix: '.0 ★', label: 'Avaliação das famílias', icon: '⭐' },
          ].map((stat) => (
            <div class="animate-on-scroll" style="padding:1.5rem;">
              <div style="font-size:2rem;margin-bottom:0.5rem;" aria-hidden="true">{stat.icon}</div>
              <div style="font-size:clamp(2rem,4vw,3rem);font-weight:900;color:var(--color-primary);">
                <span data-target={stat.target}>0</span>{stat.suffix}
              </div>
              <div style="color:var(--color-dark-muted);font-size:0.9rem;margin-top:0.25rem;">{stat.label}</div>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- COMO FUNCIONA -->
    <section class="section-padding" style="background:var(--color-primary);" aria-labelledby="matricula-heading">
      <div style="max-width:900px;margin:0 auto;text-align:center;">
        <h2 id="matricula-heading" style="font-size:clamp(1.75rem,3vw,2.25rem);color:white;margin:0 0 0.75rem;">
          Matrícula simples e sem complicação
        </h2>
        <p style="color:rgba(255,255,255,0.85);font-size:1.05rem;margin:0 0 3rem;">Em 3 passos, seu filho começa a jornada na Educa Bem.</p>

        <div class="mobile-col" style="display:grid;grid-template-columns:repeat(3,1fr);gap:2rem;margin-bottom:3rem;">
          {[
            { num: '①', title: 'Agende uma visita', desc: 'Marque pelo WhatsApp ou telefone no horário que preferir.' },
            { num: '②', title: 'Conheça a escola', desc: 'Venha ver as salas, conversar com a equipe e sentir o ambiente.' },
            { num: '③', title: 'Matrícula feita!', desc: 'Documentação simples e processo rápido. Seu filho já pode começar.' },
          ].map((step) => (
