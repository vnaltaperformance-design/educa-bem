---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

const WA_LINK = "https://wa.me/5511993484371?text=Ol%C3%A1!%20Tenho%20uma%20d%C3%BAvida%20sobre%20a%20Educa%20Bem%20que%20n%C3%A3o%20encontrei%20no%20site.%20Podem%20me%20ajudar%3F";

const faqs = [
  {
    categoria: 'Matrículas e Vagas',
    perguntas: [
      { q: 'As matrículas estão abertas?', a: 'Sim! A Educa Bem aceita matrículas o ano todo. Entre em contato pelo WhatsApp (11) 99348-4371 para verificar vagas disponíveis em cada turma.' },
      { q: 'A partir de qual idade aceitam crianças?', a: 'Aceitamos crianças a partir de 4 meses de idade no berçário. O atendimento vai até os 5 anos (turma Jardim).' },
      { q: 'Quais documentos preciso para a matrícula?', a: 'Entre em contato conosco pelo WhatsApp e enviamos a lista completa de documentos necessários para a matrícula.' },
      { q: 'É possível fazer um período experimental?', a: 'Não trabalhamos com períodos experimentais, mas oferecemos visitas gratuitas para as famílias conhecerem a escola antes da matrícula. Agende pelo WhatsApp!' },
    ],
  },
  {
    categoria: 'Proposta Pedagógica',
    perguntas: [
      { q: 'Qual é a metodologia da Escola Educa Bem?', a: 'Usamos a abordagem Reggio Emilia com base sócio-interacionista, fundamentada em Vygotsky, Piaget e Freinet. Nossa metodologia de Projetos organiza o currículo em torno da curiosidade infantil.' },
      { q: 'O que é a Metodologia Reggio Emilia?', a: 'Reggio Emilia é uma abordagem italiana reconhecida como a melhor para educação infantil. Nela, a criança é protagonista e pesquisadora do próprio conhecimento. O ambiente, a arte e a interação social são centrais no processo de aprendizagem.' },
      { q: 'Como funciona a Metodologia de Projetos?', a: 'O currículo é organizado em torno de temas investigativos que partem da curiosidade das crianças. Uma pergunta ("como crescem as plantas?") vira um projeto real de investigação com experimentos, registros e apresentações.' },
      { q: 'A escola tem ensino de inglês?', a: 'No momento, nosso foco é na base pedagógica sócio-interacionista e Reggio Emilia em português. Entre em contato para saber sobre possíveis atualizações da grade.' },
    ],
  },
  {
    categoria: 'Alimentação',
    perguntas: [
      { q: 'A escola tem nutricionista?', a: 'Sim! Nossa nutricionista está presente todos os dias — não é terceirizada. Ela planeja cardápios adaptados por faixa etária e atende individualmente crianças com necessidades alimentares especiais.' },
      { q: 'Como funciona para crianças com alergias alimentares?', a: 'Atendemos com segurança crianças com alergias, intolerâncias (lactose, glúten, etc.) e preferências alimentares como dieta vegetariana. A nutricionista elabora cardápios individualizados.' },
      { q: 'A escola armazena leite materno?', a: 'Sim! Para os bebês do berçário, oferecemos armazenamento seguro de leite materno, apoiando o aleitamento materno e orientando as mães sobre o processo.' },
      { q: 'As refeições são preparadas na escola?', a: 'Sim, todas as refeições são preparadas fresquinhas diariamente em nossa cozinha, por uma cozinheira especializada em alimentação infantil, sob supervisão da nutricionista.' },
    ],
  },
  {
    categoria: 'Estrutura e Segurança',
    perguntas: [
      { q: 'Onde fica a Escola Educa Bem?', a: 'Estamos na R. Dr. Miranda de Azevedo, 920, Pompeia, São Paulo/SP (CEP 05027-000). Próximo a Perdizes e Alto de Pinheiros.' },
      { q: 'Quais são os horários de funcionamento?', a: 'Funcionamos de segunda a sexta-feira, das 07h às 18h. Turno manhã: 07h às 12h. Turno tarde: 13h às 18h. Entre em contato para informações sobre turno integral.' },
      { q: 'A escola tem área externa e natureza?', a: 'Sim! Temos espaço amplo com área verde, árvores frutíferas e horta própria. O contato com a natureza é parte essencial da nossa proposta pedagógica Reggio Emilia.' },
      { q: 'Como é a comunicação com as famílias?', a: 'Mantemos comunicação ativa com as famílias sobre o desenvolvimento e rotina das crianças. Atualizações e registros das atividades são compartilhados regularmente.' },
    ],
  },
];

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": faqs.flatMap(cat => cat.perguntas.map(p => ({
    "@type": "Question",
    "name": p.q,
    "acceptedAnswer": { "@type": "Answer", "text": p.a }
  })))
};
---

<Layout
  title="Perguntas Frequentes — FAQ | Escola Educa Bem Pompeia SP"
  description="Tire suas dúvidas sobre a Escola Educa Bem: matrículas, metodologia Reggio Emilia, alimentação, nutricionista, horários e estrutura. Berçário e Ed. Infantil na Pompeia."
  canonical="/faq"
  schema={faqSchema}
>
  <Header />
  <main id="main-content">

    <section style="background:var(--color-accent);padding:5rem 1.5rem;" aria-labelledby="faq-heading">
      <div style="max-width:800px;margin:0 auto;text-align:center;">
        <span style="font-size:2.5rem;" aria-hidden="true">❓</span>
        <h1 id="faq-heading" style="font-size:clamp(2rem,4vw,2.75rem);font-weight:900;color:var(--color-dark);margin:0.75rem 0 1rem;">
          Perguntas Frequentes
        </h1>
        <p style="color:var(--color-dark-muted);font-size:1.05rem;margin:0;">
          As dúvidas mais comuns dos pais — respondidas com clareza e honestidade.
        </p>
      </div>
    </section>

    <section class="section-padding">
      <div style="max-width:800px;margin:0 auto;">
        {faqs.map((cat) => (
          <div style="margin-bottom:3rem;">
            <h2 style="font-size:1.25rem;font-weight:800;color:var(--color-primary);margin:0 0 1rem;padding-bottom:0.5rem;border-bottom:2px solid var(--color-primary-light);">
              {cat.categoria}
            </h2>
            <div style="display:flex;flex-direction:column;gap:0.75rem;">
              {cat.perguntas.map((item) => (
                <details class="animate-on-scroll" style="background:white;border-radius:16px;padding:1.25rem 1.5rem;box-shadow:0 2px 8px rgba(0,0,0,0.05);">
                  <summary style="display:flex;justify-content:space-between;align-items:center;font-weight:800;color:var(--color-dark);font-size:1rem;line-height:1.4;">
                    {item.q}
                    <span class="faq-icon" style="color:var(--color-primary);font-size:1.5rem;margin-left:1rem;flex-shrink:0;" aria-hidden="true">+</span>
                  </summary>
                  <p style="margin:1rem 0 0;color:var(--color-dark-muted);line-height:1.7;font-size:0.95rem;">{item.a}</p>
                </details>
              ))}
            </div>
          </div>
        ))}

        <!-- Não encontrou? -->
        <div class="animate-on-scroll" style="background:var(--color-primary-light);border-radius:24px;padding:2.5rem;text-align:center;margin-top:2rem;">
          <div style="font-size:2rem;margin-bottom:0.75rem;" aria-hidden="true">💬</div>
          <h3 style="font-size:1.2rem;font-weight:800;color:var(--color-dark);margin:0 0 0.75rem;">
            Não encontrou sua dúvida?
          </h3>
          <p style="color:var(--color-dark-muted);margin:0 0 1.5rem;">
            Fale diretamente com nossa equipe pelo WhatsApp. Respondemos rapidinho!
          </p>
          <a href={WA_LINK} target="_blank" rel="noopener noreferrer" class="btn-primary">
            💬 Falar no WhatsApp
          </a>
        </div>
      </div>
    </section>

  </main>
  <Footer />
</Layout>
