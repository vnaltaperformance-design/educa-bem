---
---

<footer style="background:var(--color-dark);color:white;padding:4rem 1.5rem 2rem;" role="contentinfo">
  <div style="max-width:1200px;margin:0 auto;">

    <!-- Grid principal -->
    <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(220px,1fr));gap:3rem;margin-bottom:3rem;">

      <!-- Logo + Sobre -->
      <div>
        <div style="display:flex;align-items:center;gap:0.5rem;margin-bottom:1rem;">
          <span style="font-size:1.75rem;">🎒</span>
          <div>
            <div style="font-weight:900;font-size:1.2rem;color:var(--color-primary);">Educa Bem</div>
            <div style="font-size:0.7rem;color:rgba(255,255,255,0.5);text-transform:uppercase;letter-spacing:0.05em;">Escola Infantil</div>
          </div>
        </div>
        <p style="font-size:0.9rem;color:rgba(255,255,255,0.7);line-height:1.7;margin:0 0 1.5rem;">
          Berçário e Educação Infantil na Pompeia com metodologia Reggio Emilia.
          Crianças de 4 meses a 5 anos.
        </p>
        <div class="stars" aria-label="Avaliação 5 estrelas">★★★★★</div>
        <div style="font-size:0.85rem;color:rgba(255,255,255,0.6);margin-top:0.25rem;">5.0 — Avaliação das famílias</div>
      </div>

      <!-- Páginas -->
      <div>
        <h3 style="font-size:1rem;font-weight:800;color:white;margin:0 0 1.25rem;text-transform:uppercase;letter-spacing:0.08em;">Conheça</h3>
        <ul style="list-style:none;margin:0;padding:0;display:flex;flex-direction:column;gap:0.5rem;">
          {[
            ['/proposta-pedagogica', 'Proposta Pedagógica'],
            ['/bercario', 'Berçário'],
            ['/educacao-infantil', 'Educação Infantil'],
            ['/alimentacao', 'Alimentação'],
            ['/estrutura', 'Estrutura Física'],
            ['/faq', 'Perguntas Frequentes'],
            ['/blog', 'Blog'],
          ].map(([href, label]) => (
            <li>
              <a href={href} style="color:rgba(255,255,255,0.7);text-decoration:none;font-size:0.9rem;transition:color 0.2s;" onmouseover="this.style.color='var(--color-primary)'" onmouseout="this.style.color='rgba(255,255,255,0.7)'">
                {label}
              </a>
            </li>
          ))}
        </ul>
      </div>

      <!-- Contato -->
      <div>
        <h3 style="font-size:1rem;font-weight:800;color:white;margin:0 0 1.25rem;text-transform:uppercase;letter-spacing:0.08em;">Contato</h3>
        <address style="font-style:normal;display:flex;flex-direction:column;gap:1rem;">
          <a
            href="https://maps.google.com/?q=R.+Dr.+Miranda+de+Azevedo,+920,+Pompeia,+SP"
            target="_blank"
            rel="noopener noreferrer"
            style="color:rgba(255,255,255,0.7);text-decoration:none;font-size:0.9rem;display:flex;gap:0.5rem;align-items:flex-start;"
          >
            <span aria-hidden="true">📍</span>
            <span>R. Dr. Miranda de Azevedo, 920<br />Pompeia, São Paulo — SP<br />CEP 05027-000</span>
          </a>

          <a href="tel:+5511993484371" style="color:rgba(255,255,255,0.7);text-decoration:none;font-size:0.9rem;display:flex;gap:0.5rem;align-items:center;">
            <span aria-hidden="true">📱</span> (11) 99348-4371
          </a>

          <a href="tel:+551136726082" style="color:rgba(255,255,255,0.7);text-decoration:none;font-size:0.9rem;display:flex;gap:0.5rem;align-items:center;">
            <span aria-hidden="true">☎️</span> (11) 3672-6082
          </a>

          <a
            href="https://www.instagram.com/educa_bem"
            target="_blank"
            rel="noopener noreferrer"
            style="color:rgba(255,255,255,0.7);text-decoration:none;font-size:0.9rem;display:flex;gap:0.5rem;align-items:center;"
          >
            <span aria-hidden="true">📸</span> @educa_bem
          </a>
        </address>
      </div>

      <!-- Horários -->
      <div>
        <h3 style="font-size:1rem;font-weight:800;color:white;margin:0 0 1.25rem;text-transform:uppercase;letter-spacing:0.08em;">Horários</h3>
        <div style="display:flex;flex-direction:column;gap:0.75rem;">
          <div>
            <div style="font-weight:700;color:white;font-size:0.9rem;">Segunda a Sexta</div>
            <div style="color:rgba(255,255,255,0.7);font-size:0.875rem;">07h00 às 18h00</div>
          </div>
          <div>
            <div style="font-weight:700;color:var(--color-accent);font-size:0.9rem;">Turno Manhã</div>
            <div style="color:rgba(255,255,255,0.7);font-size:0.875rem;">07h00 às 12h00</div>
          </div>
          <div>
            <div style="font-weight:700;color:var(--color-accent);font-size:0.9rem;">Turno Tarde</div>
            <div style="color:rgba(255,255,255,0.7);font-size:0.875rem;">13h00 às 18h00</div>
          </div>
          <div style="margin-top:0.5rem;">
            <span style="background:var(--color-secondary);color:white;border-radius:20px;padding:4px 14px;font-size:0.8rem;font-weight:700;">
              🟢 Matrículas abertas
            </span>
          </div>
        </div>

        <div style="margin-top:1.5rem;">
          <a
            href="https://wa.me/5511993484371?text=Ol%C3%A1!%20Vi%20o%20site%20da%20Educa%20Bem%20e%20quero%20saber%20mais%20sobre%20as%20matr%C3%ADculas.%20Podem%20me%20ajudar%3F"
            target="_blank"
            rel="noopener noreferrer"
            class="btn-primary"
            style="font-size:0.9rem;padding:12px 20px;"
          >
            💬 Fale conosco
          </a>
        </div>
      </div>
    </div>

    <!-- Google Maps embed -->
    <div style="border-radius:16px;overflow:hidden;margin-bottom:2rem;">
      <iframe
        src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d3657.7!2d-46.6877!3d-23.5353!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x0%3A0x0!2zMjPCsDMyJzA3LjEiUyA0NsKwNDEnMTUuNyJX!5e0!3m2!1spt-BR!2sbr!4v1"
        width="100%"
        height="200"
        style="border:0;display:block;"
        allowfullscreen=""
        loading="lazy"
        referrerpolicy="no-referrer-when-downgrade"
        title="Localização da Escola Educa Bem no Google Maps"
      ></iframe>
    </div>

    <!-- Bottom bar -->
    <div style="border-top:1px solid rgba(255,255,255,0.1);padding-top:1.5rem;display:flex;flex-wrap:wrap;gap:1rem;justify-content:space-between;align-items:center;">
      <p style="margin:0;font-size:0.8rem;color:rgba(255,255,255,0.4);">
        © 2025 Escola Educa Bem. Todos os direitos reservados.
      </p>
      <p style="margin:0;font-size:0.8rem;color:rgba(255,255,255,0.4);">
        CNPJ: a confirmar | R. Dr. Miranda de Azevedo, 920 — Pompeia/SP
      </p>
      <div style="display:flex;gap:1rem;">
        <a href="/sitemap-index.xml" style="font-size:0.8rem;color:rgba(255,255,255,0.4);text-decoration:none;">Sitemap</a>
        <a href="/contato" style="font-size:0.8rem;color:rgba(255,255,255,0.4);text-decoration:none;">Privacidade</a>
      </div>
    </div>
  </div>
</footer>
