---
const navLinks = [
  { href: '/proposta-pedagogica', label: 'Proposta' },
  { href: '/bercario', label: 'Berçário' },
  { href: '/educacao-infantil', label: 'Infantil' },
  { href: '/alimentacao', label: 'Alimentação' },
  { href: '/estrutura', label: 'Estrutura' },
  { href: '/faq', label: 'FAQ' },
  { href: '/contato', label: 'Contato' },
];

const currentPath = Astro.url.pathname;
---

<header
  id="site-header"
  style="position:sticky;top:0;z-index:1000;background:rgba(253,248,242,0.95);backdrop-filter:blur(8px);border-bottom:1px solid rgba(244,123,32,0.1);transition:box-shadow 0.3s;"
  role="banner"
>
  <div style="max-width:1200px;margin:0 auto;padding:0 1.5rem;display:flex;align-items:center;justify-content:space-between;height:72px;">

    <!-- Logo -->
    <a href="/" aria-label="Escola Educa Bem — Página inicial" style="display:flex;align-items:center;text-decoration:none;">
      <img
        src="/images/logo.jpg"
        alt="Escola Educa Bem — Berçário e Educação Infantil"
        width="160"
        height="72"
        loading="eager"
        fetchpriority="high"
        style="height:52px;width:auto;object-fit:contain;"
      />
    </a>

    <!-- Desktop Nav -->
    <nav aria-label="Navegação principal" style="display:none;" id="desktop-nav">
      <ul style="display:flex;list-style:none;margin:0;padding:0;gap:0.25rem;align-items:center;">
        {navLinks.map(link => (
          <li>
            <a
              href={link.href}
              aria-current={currentPath.startsWith(link.href) ? 'page' : undefined}
              style={`
                padding:0.5rem 0.75rem;
                border-radius:8px;
                text-decoration:none;
                font-weight:700;
                font-size:0.9rem;
                color:${currentPath.startsWith(link.href) ? 'var(--color-primary)' : 'var(--color-dark)'};
                background:${currentPath.startsWith(link.href) ? 'var(--color-primary-light)' : 'transparent'};
                transition:all 0.2s;
              `}
            >
              {link.label}
            </a>
          </li>
        ))}
        <li style="margin-left:0.5rem;">
          <a
            href="https://wa.me/5511993484371?text=Ol%C3%A1!%20Vi%20o%20site%20da%20Educa%20Bem%20e%20quero%20saber%20mais%20sobre%20as%20matr%C3%ADculas.%20Podem%20me%20ajudar%3F"
            target="_blank"
            rel="noopener noreferrer"
            class="btn-primary"
            style="padding:10px 20px;font-size:0.9rem;"
          >
            💬 WhatsApp
          </a>
        </li>
      </ul>
    </nav>

    <!-- Mobile: WhatsApp + Hamburger -->
    <div style="display:flex;align-items:center;gap:0.75rem;" id="mobile-actions">
      <a
        href="https://wa.me/5511993484371?text=Ol%C3%A1!%20Vi%20o%20site%20da%20Educa%20Bem%20e%20quero%20saber%20mais%20sobre%20as%20matr%C3%ADculas.%20Podem%20me%20ajudar%3F"
        target="_blank"
        rel="noopener noreferrer"
        style="background:#25D366;color:white;border-radius:50px;padding:8px 16px;font-weight:800;font-size:0.85rem;text-decoration:none;display:flex;align-items:center;gap:6px;"
        aria-label="WhatsApp"
      >
        <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
          <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/>
        </svg>
        <span>WhatsApp</span>
      </a>

      <button
        id="hamburger"
        aria-label="Abrir menu de navegação"
        aria-expanded="false"
        aria-controls="mobile-menu"
        style="background:none;border:none;cursor:pointer;padding:8px;display:flex;flex-direction:column;gap:5px;min-width:48px;min-height:48px;align-items:center;justify-content:center;"
      >
        <span id="ham1" style="display:block;width:24px;height:2.5px;background:var(--color-dark);border-radius:2px;transition:all 0.3s;"></span>
        <span id="ham2" style="display:block;width:24px;height:2.5px;background:var(--color-dark);border-radius:2px;transition:all 0.3s;"></span>
        <span id="ham3" style="display:block;width:24px;height:2.5px;background:var(--color-dark);border-radius:2px;transition:all 0.3s;"></span>
      </button>
    </div>
  </div>

  <!-- Mobile Menu -->
  <div
    id="mobile-menu"
    aria-hidden="true"
    style="
      position:fixed;
      top:72px;
      right:-100%;
      width:min(320px, 100vw);
      height:calc(100vh - 72px);
      background:var(--color-bg-warm);
      padding:2rem 1.5rem;
      z-index:999;
      transition:right 0.35s cubic-bezier(0.4,0,0.2,1);
      overflow-y:auto;
      box-shadow:-4px 0 24px rgba(0,0,0,0.12);
    "
  >
    <nav aria-label="Menu mobile">
      <ul style="list-style:none;margin:0;padding:0;display:flex;flex-direction:column;gap:0.5rem;">
        {navLinks.map(link => (
          <li>
            <a
              href={link.href}
              style={`
                display:block;
                padding:1rem 1.25rem;
                border-radius:12px;
                text-decoration:none;
                font-weight:700;
                font-size:1.1rem;
                color:${currentPath.startsWith(link.href) ? 'var(--color-primary)' : 'var(--color-dark)'};
                background:${currentPath.startsWith(link.href) ? 'var(--color-primary-light)' : 'transparent'};
              `}
            >
              {link.label}
            </a>
          </li>
        ))}
      </ul>

      <div style="margin-top:2rem;padding-top:1.5rem;border-top:1px solid rgba(0,0,0,0.08);">
        <a
          href="https://wa.me/5511993484371?text=Ol%C3%A1!%20Vi%20o%20site%20da%20Educa%20Bem%20e%20quero%20saber%20mais%20sobre%20as%20matr%C3%ADculas.%20Podem%20me%20ajudar%3F"
          target="_blank"
          rel="noopener noreferrer"
          class="btn-primary"
          style="width:100%;justify-content:center;margin-bottom:1rem;"
        >
          💬 WhatsApp
        </a>
        <a
          href="tel:+5511993484371"
          class="btn-secondary"
          style="width:100%;justify-content:center;"
        >
          📞 (11) 99348-4371
        </a>
      </div>
    </nav>
  </div>
</header>

<style>
  @media (min-width: 1024px) {
    #desktop-nav { display: block !important; }
    #mobile-actions button { display: none !important; }
  }
</style>

<script>
  const hamburger = document.getElementById('hamburger');
  const mobileMenu = document.getElementById('mobile-menu');
  const ham1 = document.getElementById('ham1');
  const ham2 = document.getElementById('ham2');
  const ham3 = document.getElementById('ham3');
  let isOpen = false;

  function toggleMenu() {
    isOpen = !isOpen;
    hamburger?.setAttribute('aria-expanded', String(isOpen));
    mobileMenu?.setAttribute('aria-hidden', String(!isOpen));

    if (mobileMenu) {
      mobileMenu.style.right = isOpen ? '0' : '-100%';
    }
    if (ham1 && ham2 && ham3) {
      if (isOpen) {
        ham1.style.transform = 'rotate(45deg) translate(5px, 5px)';
        ham2.style.opacity = '0';
        ham3.style.transform = 'rotate(-45deg) translate(5px, -5px)';
      } else {
        ham1.style.transform = '';
        ham2.style.opacity = '';
        ham3.style.transform = '';
      }
    }
    document.body.style.overflow = isOpen ? 'hidden' : '';
  }

  hamburger?.addEventListener('click', toggleMenu);

  mobileMenu?.querySelectorAll('a').forEach(link => {
    link.addEventListener('click', () => {
      if (isOpen) toggleMenu();
    });
  });

  // Shadow on scroll
  const header = document.getElementById('site-header');
  window.addEventListener('scroll', () => {
    if (header) {
      header.style.boxShadow = window.scrollY > 10
        ? '0 2px 20px rgba(0,0,0,0.08)'
        : 'none';
    }
  }, { passive: true });
</script>
